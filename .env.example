# Copia este archivo a .env (ignorado por git) y cárgalo antes de iniciar mosAIc:
#   set -a; . ./.env; set +a
#   python -m uvicorn isde.api:create_app --factory --port 8001

# Claude: análisis, reformulación y transcripción de imágenes y PDF. También puede ir en el llavero con `isde key`.
ANTHROPIC_API_KEY=
# MOSAIC_CLAUDE_MODEL=claude-haiku-4-5-20251001

# ElevenLabs Scribe: transcripción de audio. Sin clave, todo audio se rechaza y queda en revisión.
ELEVENLABS_API_KEY=
# ISDE_STT_MODEL=scribe_v2

# Token para ver evidencia privada y revisar alertas en el panel. Sin él, el detalle queda cerrado.
MOSAIC_OPERATOR_TOKEN=

# Base y caso de la API. Por defecto usa mosaic-api.sqlite y los ejemplos mvp-*.yaml.
# MOSAIC_API_DB=mosaic-api.sqlite
# MOSAIC_POLICY=examples/mvp-policy.yaml
# MOSAIC_CASE=examples/mvp-case.yaml
# MOSAIC_HISTORY=examples/mvp-history.yaml
